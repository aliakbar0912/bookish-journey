# Devora admin website. Placeholders only. Local use: copy to admin/.env (ignored by Git).
# Dokploy: set these in the service's Environment tab. The values are read when the site starts and handed to the
# browser through /config.js, so changing them needs a restart of the admin service, never a rebuild.
# The browser only ever receives ADMIN_API_ORIGIN; no secret belongs in this file.
PORT=8081
HOST=0.0.0.0
# Public origin of the API service (scheme + host, no path). https in production; http only for localhost in development.
# Same value as API_ACCESS_KEY on the API server.
ADMIN_API_KEY=
ADMIN_API_ORIGIN=https://api.YOUR_DOMAIN
# Strict-Transport-Security. Defaults to true when NODE_ENV=production (the Dockerfile sets it).
ADMIN_HSTS=true
